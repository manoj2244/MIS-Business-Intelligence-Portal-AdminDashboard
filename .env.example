# Required: backend API base (NestJS)
# server/.env => PORT=8001 and API_PREFIX=api/v1
VITE_API_BASE_URL=http://localhost:8001/api/v1

# Optional overrides only (normally not needed)
# VITE_AUTH_LOGIN_PATH=/auth/login/ldap
# VITE_AUTH_REFRESH_PATH=/auth/refresh
# VITE_AUTH_LOGOUT_PATH=/auth/logout
# VITE_AUTH_PROFILE_PATH=/auth/profile
# VITE_ACCESS_TOKEN_KEY=mis-business-jwt-token
# VITE_REFRESH_TOKEN_KEY=mis-business-refresh-token
# VITE_USER_PROFILE_KEY=mis-business-user-profile
